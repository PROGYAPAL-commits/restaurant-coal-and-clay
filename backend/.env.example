# Copy this file to .env and fill in real values.

# Postgres connection string
# Local Docker default (matches docker-compose.yml):
DATABASE_URL="postgresql://coalclay:coalclay@localhost:5432/coalclay?schema=public"

# Any long random string in production
JWT_SECRET="dev-secret-change-me"

PORT=4000

# Comma-separated list of allowed frontend origins for CORS + Socket.IO
CORS_ORIGIN="http://localhost:5173,http://localhost:5174,http://localhost:5175"
